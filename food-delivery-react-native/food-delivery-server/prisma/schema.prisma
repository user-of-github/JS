generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at") // to make column name created_at inside real DB
  updatedAt DateTime @updatedAt @map("updated_at")

  email String @unique
  password String

  name String
  avatarPath String @default("/uploads/default-avatar.png") @map("avatar_path")
  phone String @default("")


  @@map("user")
}